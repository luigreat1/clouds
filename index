  body:[582,538,160,210], lid:[662,563,145], bLid:[662,563,145], region:[593,584,731,739], fronts:[9, 11],
  pal:[[255,216,134],[238,142,50],[122,58,26]], R:90},
 {id:7, type:'noon', short:'белоснежные клубы',
  name:'Плотные кучевые облака – летний полдень', badge:'конвективные облака',
  altitude:'Высота: 1,5–3 км', temp:'+24 °C (тепло)', precip:'без осадков',
