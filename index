<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Лаборатория погоды Луи</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden}
  body{
    background:linear-gradient(180deg,#1a2b4d 0%,#35568a 60%,#5b7fae 100%);
    display:flex;align-items:center;justify-content:center;
    font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
  }
  #dim{position:fixed;inset:0;background:#02040a;opacity:0;pointer-events:none;z-index:0}
  #sunglow{position:fixed;inset:0;opacity:0;pointer-events:none;z-index:0;
    background:radial-gradient(circle at 50% 25%,#ffd77a 0%,rgba(255,215,122,0) 70%)}

  #stage{position:relative;z-index:1;--u:1;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}

  /* Слои (снизу вверх):
     .hit (кликабельные зоны) — на заднем плане, под картинкой
     #scene — картинка + «открытое горлышко» (mouth), нарисованное прямо в ней
     #fx — облака, дождь, молнии
     .lidsp — летающая крышка */
  .hit{position:absolute;z-index:1;cursor:pointer}
  #scene{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}
  #fx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:4}
  .lidsp{position:absolute;z-index:6;opacity:0;pointer-events:none;transform-origin:50% 55%;
    filter:drop-shadow(0 4px 5px rgba(0,0,0,.5))}

  .debug .hit{outline:1px dashed #6f6}
  .dbg-r,.dbg-l{position:absolute;z-index:9;pointer-events:none}
  .dbg-r{outline:1px dashed #0ff}.dbg-l{outline:1px dashed #f66}

  /* карточка с названием облака — в пустом месте справа внизу */
  #card{position:absolute;z-index:8;left:75.5%;top:51%;width:23%;box-sizing:border-box;
    padding:calc(var(--u)*14px);border-radius:calc(var(--u)*14px);color:#fff;
    background:rgba(10,20,40,.58);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    border:1px solid rgba(255,255,255,.18);box-shadow:0 10px 30px rgba(0,0,0,.35);
    font-size:calc(var(--u)*13px);line-height:1.4;max-height:46%;overflow:auto;scrollbar-width:none}
  #card::-webkit-scrollbar{display:none}
  #card .row{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:calc(var(--u)*8px)}
  #badge{padding:calc(var(--u)*3px) calc(var(--u)*10px);border-radius:999px;background:rgba(125,211,252,.25);
    color:#bae6fd;font-size:calc(var(--u)*11px);text-transform:uppercase;letter-spacing:.04em}
  #alt{font-size:calc(var(--u)*11px);opacity:.7}
  #ctitle{font-size:calc(var(--u)*17px);font-weight:700;line-height:1.25;margin:0 0 calc(var(--u)*6px)}
  #cdesc{margin:0 0 calc(var(--u)*10px);opacity:.9}
  .facts{display:grid;grid-template-columns:1fr 1fr;gap:calc(var(--u)*8px)}
  .fact{background:rgba(255,255,255,.1);border-radius:calc(var(--u)*8px);padding:calc(var(--u)*6px) calc(var(--u)*8px)}
  .fact small{display:block;opacity:.6;font-size:calc(var(--u)*10px)}
  .fact b{font-weight:600}
  #tags{display:flex;flex-wrap:wrap;gap:calc(var(--u)*5px);margin-top:calc(var(--u)*10px)}
  #tags button{border:0;border-radius:8px;padding:calc(var(--u)*3px) calc(var(--u)*8px);cursor:pointer;
    background:rgba(255,255,255,.16);color:#fff;font-size:calc(var(--u)*11px)}
  #tags button:hover{background:rgba(255,255,255,.3)}

  #bar{position:fixed;left:12px;top:12px;z-index:20;display:flex;gap:8px;align-items:center}
  #bar button{border:0;border-radius:999px;height:38px;padding:0 14px;background:rgba(0,0,0,.4);color:#fff;
    font-size:14px;cursor:pointer;backdrop-filter:blur(4px)}
  #bar button:hover{background:rgba(0,0,0,.6)}
  #cnt{color:#fff;background:rgba(0,0,0,.4);border-radius:999px;height:38px;line-height:38px;padding:0 14px;font-size:14px}
  #hint{position:fixed;left:50%;top:62px;transform:translateX(-50%);z-index:20;color:#fff;
    background:rgba(0,0,0,.4);padding:8px 16px;border-radius:999px;font-size:15px;
    pointer-events:none;transition:opacity .6s;backdrop-filter:blur(4px);white-space:nowrap}
  #tip{position:fixed;z-index:50;pointer-events:none;opacity:0;transition:opacity .15s;color:#fff;
    background:rgba(15,23,42,.92);padding:6px 12px;border-radius:12px;font-size:13px;max-width:260px;
    border:1px solid rgba(148,163,184,.35);box-shadow:0 4px 12px rgba(0,0,0,.4)}
  #tip small{display:block;opacity:.65;margin-top:2px}
  #warn{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:30;color:#fff;
    background:rgba(120,20,20,.88);padding:16px 22px;border-radius:12px;max-width:80vw;text-align:center}
  @media (max-width:700px){#hint{display:none}}
   .background-layer {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background-image: url('nature.png'); /* картинка рядом с index.html */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .content {
            position: relative;
            z-index: 1;
            padding: 40px;
            color: white;
            font-family: Arial, sans-serif;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
        }
</style>
