/* ====== ОБЛАКО ====== */
const PUFFS=[[-.95,.10,.45,0],[-.5,.2,.5,1],[0,.25,.55,2],[.5,.2,.5,3],[.95,.1,.42,4],
  [-.2,-.1,.55,5],[.25,-.1,.55,6],[-.55,-.25,.5,7],[.55,-.25,.5,8],[0,-.4,.62,9]];
function drawPuffs(x,y,R,pal,a,t,st){
  for(const p of PUFFS){
    const wob=1+.06*Math.sin(t*1.3+p[3]);
    const px=x+p[0]*R*wob*st, py=y+p[1]*R*.8+Math.sin(t*.8+p[3])*R*.03, pr=p[2]*R*wob;
    const g=ctx.createRadialGradient(px-pr*.25,py-pr*.35,pr*.1,px,py,pr);
    g.addColorStop(0,rgba(pal[0],a)); g.addColorStop(.55,rgba(pal[1],a));
    g.addColorStop(.88,rgba(pal[2],a*.9)); g.addColorStop(1,rgba(pal[2],0));
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(px,py,pr,0,TAU); ctx.fill();
  }
}
function drawCloud(c){
  const cfg=c.cfg, a=c.state==='returning'?Math.min(1,c.k*6):1, R=c.RR, x=c.x, y=c.y;
  if(a<=.01||R<2)return;
  if(cfg.glow){
    ctx.save(); ctx.globalCompositeOperation='lighter';
    const g=ctx.createRadialGradient(x,y+R*.2,R*.2,x,y+R*.2,R*1.7);
    g.addColorStop(0,`rgba(${cfg.glow},${.4*a})`); g.addColorStop(1,`rgba(${cfg.glow},0)`);
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y+R*.2,R*1.7,0,TAU); ctx.fill(); ctx.restore();
  }
  drawPuffs(x,y,R,c.pal,a,c.t,1);
  if(c.glow>.02){
    ctx.save(); ctx.globalCompositeOperation='lighter';
    const g=ctx.createRadialGradient(x,y,0,x,y,R*1.3);
    g.addColorStop(0,`rgba(200,210,255,${c.glow*.6})`); g.addColorStop(1,'rgba(200,210,255,0)');
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y,R*1.3,0,TAU); ctx.fill(); ctx.restore();
  }
}

/* ====== ЧАСТИЦЫ: шаг и отрисовка ====== */
function stepParticle(p,dt){
  switch(p.k){
    case 'rain':{
      p.x+=p.vx*dt; p.y+=p.vy*dt;
      if(p.y>=p.gy){P.push({k:'splash',x:p.x,y:p.gy,t:0});return false;}
      ctx.strokeStyle=`rgba(${p.col},.65)`; ctx.lineWidth=p.w*S+.3;
      ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(p.x-p.vx*p.len,p.y-p.vy*p.len); ctx.stroke(); return true;}
    case 'splash':{
      p.t+=dt; if(p.t>=.28)return false;
      const r=(p.t/.28)*7*S;
      ctx.strokeStyle=`rgba(200,222,245,${1-p.t/.28})`; ctx.lineWidth=1.2*S+.2;
      ctx.beginPath(); ctx.ellipse(p.x,p.y,r,r*.35,0,0,TAU); ctx.stroke(); return true;}
    case 'hail':{
      if(p.lie>0){p.lie+=dt;if(p.lie>1)return false;}
      else{
        p.vy+=1700*S*dt; p.x+=p.vx*dt; p.y+=p.vy*dt;
        if(p.y>=p.gy){p.y=p.gy;
          if(p.b>=2){p.lie=.001;p.vy=0;p.vx=0;}
          else{p.vy=-p.vy*.42;p.vx*=.8;p.b++;if(Math.random()<.1)hailTick();}}
      }
      const a=p.lie>0?1-p.lie:1;
      const g=ctx.createRadialGradient(p.x-p.r*.3,p.y-p.r*.3,0,p.x,p.y,p.r);
      g.addColorStop(0,`rgba(255,255,255,${a})`); g.addColorStop(1,`rgba(170,200,230,${a})`);
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,TAU); ctx.fill(); return true;}
    case 'spark':{
      p.t+=dt; if(p.t>=p.life)return false;
      p.vy+=700*S*dt; p.vx*=1-1.2*dt; p.x+=p.vx*dt; p.y+=p.vy*dt;
      const r=p.t/p.life;
      ctx.save(); ctx.globalCompositeOperation='lighter';
      ctx.strokeStyle=`hsla(${50-r*40},100%,${70-r*20}%,${1-r})`; ctx.lineWidth=p.r; ctx.lineCap='round';
      ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(p.x-p.vx*.03,p.y-p.vy*.03); ctx.stroke(); ctx.restore(); return true;}
    case 'smoke':{
      p.t+=dt; if(p.t>=p.life)return false;
      p.x+=p.vx*dt; p.y+=p.vy*dt;
      const r=p.r+p.gr*p.t, a=p.a*(1-p.t/p.life);
      const g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,r);
      g.addColorStop(0,rgba(p.col,a)); g.addColorStop(1,rgba(p.col,0));
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(p.x,p.y,r,0,TAU); ctx.fill(); return true;}
    case 'fog':{
      p.t+=dt; if(p.t>=p.life)return false;
      p.x+=p.vx*dt; p.y+=p.vy*dt;
      const a=p.A*Math.sin(Math.PI*p.t/p.life);
      const g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r);
      g.addColorStop(0,`rgba(${p.col},${a})`); g.addColorStop(1,`rgba(${p.col},0)`);
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,TAU); ctx.fill(); return true;}
    case 'wind':{
      p.ph+=dt*p.fq; p.x+=p.vx*dt;
      const y=p.y0+Math.sin(p.ph)*p.amp;
      p.trail.push([p.x,y]); if(p.trail.length>p.len)p.trail.shift();
      if(p.x>SW+300*S)return false;
      ctx.lineWidth=p.w*S+.3; ctx.lineCap='round';
      for(let i=1;i<p.trail.length;i++){
        ctx.strokeStyle=`rgba(${p.col},${i/p.trail.length*.55})`;
        ctx.beginPath(); ctx.moveTo(p.trail[i-1][0],p.trail[i-1][1]); ctx.lineTo(p.trail[i][0],p.trail[i][1]); ctx.stroke();
      } return true;}
    case 'dust':{
      p.t+=dt; p.ph+=dt*3; p.x+=p.vx*dt;
      if(p.x>SW+20)return false;
      const y=p.y0+Math.sin(p.ph)*p.amp+p.t*6*S;
      ctx.fillStyle=`rgba(${p.col},.75)`; ctx.beginPath(); ctx.arc(p.x,y,p.r,0,TAU); ctx.fill(); return true;}
    case 'leaf':{
      p.t+=dt; p.ph+=dt*2.2; p.x+=p.vx*dt; p.rot+=p.sp*dt;
      const y=p.y0+Math.sin(p.ph)*p.amp+p.sink*p.t;
      if(p.x>SW+40*S||y>SH+40)return false;
      ctx.save(); ctx.translate(p.x,y); ctx.rotate(p.rot); ctx.fillStyle=p.col;
      ctx.beginPath(); ctx.ellipse(0,0,p.sz,p.sz*.5,0,0,TAU); ctx.fill(); ctx.restore(); return true;}
    case 'tw':{
      p.t+=dt; if(p.t>=p.life)return false;
      const a=Math.sin(Math.PI*p.t/p.life), s=p.s*(.6+.4*a);
      ctx.save(); ctx.globalCompositeOperation='lighter'; ctx.strokeStyle=`rgba(255,235,150,${a})`;
      ctx.lineWidth=1.4*S+.2; ctx.lineCap='round'; ctx.beginPath();
      ctx.moveTo(p.x-s,p.y); ctx.lineTo(p.x+s,p.y); ctx.moveTo(p.x,p.y-s); ctx.lineTo(p.x,p.y+s); ctx.stroke(); ctx.restore(); return true;}
    case 'drift':{
      p.age+=dt; p.x+=p.vx*dt;
      if(p.x-p.R*2>SW)return false;
      let out=0;
      if(!p.owner.alive||p.owner.state==='returning'){p.out=(p.out||0)+dt*.9;out=p.out;if(out>=1)return false;}
      const edge=clamp(Math.min((p.x+p.R*2)/(p.R*3),(SW+p.R*2-p.x)/(p.R*3)),0,1);
      const a=p.a*edge*Math.min(1,p.age/1.2)*(1-out);
      if(a>.01)drawPuffs(p.x,p.y,p.R,p.pal,a,p.t+p.age,1);
      return true;}
  }
  return false;
}
function drawBolts(dt){
  for(let i=B.length-1;i>=0;i--){
    const b=B[i]; b.t+=dt;
    if(b.t>=b.life){B.splice(i,1);continue;}
    const a=(1-b.t/b.life)*(.6+.4*Math.random());
    ctx.save(); ctx.globalCompositeOperation='lighter'; ctx.lineJoin='round'; ctx.lineCap='round';
    for(const [pts,w] of [[b.pts,1],...b.branches.map(x=>[x,.55])]){
      for(const [lw,col] of [[14,`rgba(150,170,255,${.25*a})`],[6,`rgba(200,215,255,${.6*a})`],[2.5,`rgba(255,255,255,${a})`]]){
        ctx.lineWidth=lw*S*w; ctx.strokeStyle=col; ctx.beginPath();
        pts.forEach((q,j)=>j?ctx.lineTo(q[0],q[1]):ctx.moveTo(q[0],q[1])); ctx.stroke();
      }
    }
    ctx.restore();
  }
}

/* ====== КАРТИНКИ: полная и пустая, совмещённые по крышкам ====== */
let imgA=null, imgB=null;
function loadImg(src){return new Promise(res=>{const im=new Image();im.onload=()=>res(im);im.onerror=()=>res(null);im.src=src;});}

function buildJarAssets(j){
  const [x0,y0,x1,y1]=j.region, rw=x1-x0, rh=y1-y0;
  // мягкая маска области (без ближних банок)
  const m=document.createElement('canvas'); m.width=rw; m.height=rh;
  const g=m.getContext('2d');
  try{g.filter='blur(3px)';}catch(e){}
  g.fillStyle='#fff'; rr(g,4,3,rw-8,rh-8,10); g.fill();
  g.globalCompositeOperation='destination-out';
  for(const fid of j.fronts){const f=byId(fid).body; g.fillRect(f[0]-x0,f[1]-y0,f[2],f[3]);}
  g.filter='none';
  j.mask=m;
  // содержимое — кусок пустой картинки, подогнанный по крышке
  if(imgB){
    const [ax,ay,aw]=j.lid, [bx,by,bw]=j.bLid, s=aw/bw;
    const c=document.createElement('canvas'); c.width=rw; c.height=rh;
    const h=c.getContext('2d');
    h.drawImage(imgB,(x0-ax)/s+bx,(y0-ay)/s+by,rw/s,rh/s,0,0,rw,rh);
    h.globalCompositeOperation='destination-in'; h.drawImage(m,0,0);
    j.content=c;
  }
  // спрайт крышки — вырезан из самой картинки
  const [lx,ly,lw]=j.lid, lh=lw*.3, pad=4;
  const sp=document.createElement('canvas'); sp.width=Math.round(lw+pad*2); sp.height=Math.round(lh+pad*2);
  const k=sp.getContext('2d');
  k.save(); rr(k,pad,pad,lw,lh,lh*.48); k.clip();
  k.drawImage(imgA,lx-lw/2-pad,ly-lh/2-pad,sp.width,sp.height,0,0,sp.width,sp.height); k.restore();
  sp.className='lidsp'; sp.style.left=((lx-lw/2-pad)/W0*100)+'%'; sp.style.top=((ly-lh/2-pad)/H0*100)+'%';
  sp.style.width=(sp.width/W0*100)+'%'; sp.style.height=(sp.height/H0*100)+'%';
  stage.appendChild(sp); j.sprite=sp;
}

/* «горлышко» (mouth) — рисуется прямо в сцене под крышкой-спрайтом */
function paintMouth(j,p){
  const [cx,cy,w]=j.lid, u=S, ux=cx*u, uy=cy*SY;
  const ctxm=sctx; ctxm.save(); ctxm.globalAlpha=p;
  const bw=w*.97*u, bh=w*.19*SY, bx=ux-bw/2, by=(cy-.045*w)*SY;
  let g=ctxm.createLinearGradient(bx,0,bx+bw,0);
  g.addColorStop(0,'#8fa9b5'); g.addColorStop(.15,'#d6e8ef'); g.addColorStop(.5,'#b9d1db'); g.addColorStop(.85,'#d6e8ef'); g.addColorStop(1,'#86a0ad');
  ctxm.fillStyle=g; rr(ctxm,bx,by,bw,bh,bh*.5); ctxm.fill();
  ctxm.strokeStyle='rgba(60,85,98,.55)'; ctxm.lineWidth=1.2*u; ctxm.stroke();
  const ey=(cy-.04*w)*SY, rx=w*.5*u, ry=w*.105*SY;
  g=ctxm.createRadialGradient(ux,ey,rx*.1,ux,ey,rx);
  g.addColorStop(0,'#101b22'); g.addColorStop(.7,'#243743'); g.addColorStop(1,'#46606c');
  ctxm.fillStyle=g; ctxm.beginPath(); ctxm.ellipse(ux,ey,rx,ry,0,0,TAU); ctxm.fill();
  ctxm.strokeStyle='rgba(228,242,248,.95)'; ctxm.lineWidth=2.2*u; ctxm.stroke();
  ctxm.restore();
}
function drawScene(dt){
  sctx.clearRect(0,0,SW,SH);
  if(imgA)sctx.drawImage(imgA,0,0,SW,SH);
  for(const j of JARS){
    const tR=j.rt, tM=j.mt;
    j.rp=clamp(j.rp+Math.sign(tR-j.rp)*dt*2.5,0,1); if(Math.abs(tR-j.rp)<.02)j.rp=tR;
    j.mp=clamp(j.mp+Math.sign(tM-j.mp)*dt*8,0,1);   if(Math.abs(tM-j.mp)<.02)j.mp=tM;
    if(j.rp>.005&&j.mask){
      const [x0,y0,x1,y1]=j.region, dx=x0*S, dy=y0*SY, dw=(x1-x0)*S, dh=(y1-y0)*SY;
      sctx.save(); sctx.globalCompositeOperation='destination-out'; sctx.globalAlpha=j.rp; sctx.drawImage(j.mask,dx,dy,dw,dh); sctx.restore();
      if(j.content){sctx.save(); sctx.globalAlpha=j.rp; sctx.drawImage(j.content,dx,dy,dw,dh); sctx.restore();}
    }
    if(j.mp>.005)paintMouth(j,j.mp);
  }
}

/* ====== БАНКИ: клики, крышка, облако ====== */
const pct=(v,t)=>(v/t*100)+'%';
const cnt=document.getElementById('cnt'), tags=document.getElementById('tags');
const openSet=new Set();
function buildHits(){
  for(const j of JARS){
    Object.assign(j,{open:false,cloud:null,timers:[],rp:0,rt:0,mp:0,mt:0});
    const [x,y,w,h]=j.body;
    const hit=document.createElement('div'); hit.className='hit';
    Object.assign(hit.style,{left:pct(x,W0),top:pct(y,H0),width:pct(w,W0),height:pct(h,H0)});
    hit.addEventListener('click',()=>{ac();hint.style.opacity=0;j.open?closeJar(j):openJar(j);});
    hit.addEventListener('mouseenter',()=>{tip.innerHTML=`<b>${j.short}</b><small>${j.open?'нажми, чтобы вернуть облако':'нажми, чтобы открутить крышку'}</small>`;tip.style.opacity=1;});
    hit.addEventListener('mousemove',e=>{tip.style.left=(e.clientX+14)+'px';tip.style.top=(e.clientY-46)+'px';});
    hit.addEventListener('mouseleave',()=>{tip.style.opacity=0;});
    stage.insertBefore(hit,scn);
    j.hit=hit;
    if(DEBUG){
      const r=document.createElement('div');r.className='dbg-r';const q=j.region;
      Object.assign(r.style,{left:pct(q[0],W0),top:pct(q[1],H0),width:pct(q[2]-q[0],W0),height:pct(q[3]-q[1],H0)});stage.appendChild(r);
      const l=document.createElement('div');l.className='dbg-l';
      Object.assign(l.style,{left:pct(j.lid[0]-j.lid[2]/2,W0),top:pct(j.lid[1]-j.lid[2]*.15,H0),width:pct(j.lid[2],W0),height:pct(j.lid[2]*.3,H0)});stage.appendChild(l);
    }
  }
}
function later(j,ms,fn){const t=setTimeout(fn,ms);j.timers.push(t);}
function clearTimers(j){j.timers.forEach(clearTimeout);j.timers=[];}
function lidPx(j){return j.lid[2]*S;}

function openJar(j){
  j.open=true; clearTimers(j); popSnd(); lidSnd(true);
  j.rt=1; j.mt=1;
  j.sprite.getAnimations().forEach(a=>a.cancel());
  const lw=lidPx(j);
  j.sprite.animate([
    {opacity:1,transform:'translate(0,0) rotate(0deg)',offset:0},
    {opacity:1,transform:`translate(${-lw*.02}px,${-lw*.06}px) rotate(-7deg)`,offset:.15},
    {opacity:1,transform:`translate(${lw*.02}px,${-lw*.12}px) rotate(6deg)`,offset:.3},
    {opacity:1,transform:`translate(${-lw*.02}px,${-lw*.2}px) rotate(-9deg)`,offset:.45},
    {opacity:.9,transform:`translate(${lw*.15}px,${-lw*.5}px) rotate(60deg)`,offset:.7},
    {opacity:0,transform:`translate(${lw*.7}px,${-lw*1.0}px) rotate(220deg)`,offset:1}
  ],{duration:1000,easing:'ease-out',fill:'forwards'});
  later(j,450,()=>{
    if(!j.open)return;
    const mx=j.lid[0]*S, my=j.lid[1]*SY;
    for(let i=0;i<12;i++)P.push({k:'smoke',x:mx+rnd(-.3,.3)*lidPx(j),y:my,vx:rnd(-20,20)*S,vy:-rnd(20,60)*S,
      r:10*S,gr:22*S,t:0,life:rnd(.5,.9),a:.55,col:[235,240,245]});
    if(j.cloud&&clouds.includes(j.cloud)){j.cloud.state='rising';}
    else{
      const fx=EFFECTS[j.type];
      const c={jar:j,cfg:Object.assign({},fx,{}),pal:j.pal,k:0,e:0,t:Math.random()*10,state:'rising',acc:0,glow:0,alive:true,
        drift:rnd(-40,40),x:0,y:0,RR:1};
      j.cloud=c; clouds.push(c);
    }
  });
  openSet.add(j.id); updateCard(j); syncUI();
}
function closeJar(j){
  j.open=false; clearTimers(j); lidSnd(false);
  if(j.cloud)j.cloud.state='returning';
  later(j,900,()=>{
    if(j.open)return;
    j.sprite.getAnimations().forEach(a=>a.cancel());
    const lw=lidPx(j);
    j.sprite.animate([
      {opacity:0,transform:`translate(${lw*.7}px,${-lw}px) rotate(160deg)`,offset:0},
      {opacity:1,transform:'translate(0,-4px) rotate(10deg)',offset:.7},
      {opacity:1,transform:'translate(0,0) rotate(0deg)',offset:1}
    ],{duration:600,easing:'ease-in'});
  });
  later(j,1500,()=>{if(!j.open){j.rt=0;j.mt=0;}});
  openSet.delete(j.id); syncUI();
}
function closeAll(){JARS.forEach(j=>{if(j.open)closeJar(j);});resetCard();}
document.getElementById('closeAll').onclick=closeAll;

const cBadge=document.getElementById('badge'), cAlt=document.getElementById('alt'), cTitle=document.getElementById('ctitle'),
      cDesc=document.getElementById('cdesc'), cTemp=document.getElementById('ctemp'), cPrec=document.getElementById('cprec');
function updateCard(j){
  cBadge.textContent=j.badge; cAlt.textContent=j.altitude; cTitle.textContent=j.name;
  cDesc.textContent=j.desc; cTemp.textContent=j.temp; cPrec.textContent=j.precip;
}
function resetCard(){
  cBadge.textContent='метеостанция готова'; cAlt.textContent='Высота: 0–12 км';
  cTitle.textContent='лаборатория облаков — выбери любую банку';
  cDesc.textContent='Все облака собраны обратно в банки. Нажми на любую крышку, чтобы снова выпустить погодное явление!';
  cTemp.textContent='+18 °C (норма)'; cPrec.textContent='штиль, без осадков';
}
function syncUI(){
  cnt.textContent=`открыто: ${openSet.size} из ${JARS.length}`;
  tags.innerHTML='';
  JARS.forEach(j=>{ if(!j.open)return;
    const b=document.createElement('button'); b.type='button'; b.textContent='✕ '+j.short; b.title='Закрыть эту банку';
    b.onclick=()=>{closeJar(j);}; tags.appendChild(b); });
  if(!openSet.size&&false)resetCard();
}

/* ====== ГЛАВНЫЙ ЦИКЛ ====== */
let last=performance.now();
function frame(now){
  DT=Math.min(.05,(now-last)/1000); last=now; const dt=DT;
  drawScene(dt);
  ctx.clearRect(0,0,SW,SH);
  let dark=0, sunV=0;

  for(const c of clouds){
    const cfg=c.cfg, j=c.jar;
    c.t+=dt;
    if(c.state==='rising'){c.k=Math.min(1,c.k+dt/1.8);if(c.k>=1)c.state='active';}
    else if(c.state==='returning'){c.k=Math.max(0,c.k-dt/1.4);}
    const e=ease(c.k); c.e=e;
    c.RR0=j.R*S;
    const rg=j.region, sR=(rg[2]-rg[0])*.34*S;
    c.mx=((rg[0]+rg[2])/2)*S; c.my=(rg[1]+(rg[3]-rg[1])*.42)*SY;
    c.hx=clamp(c.mx+c.drift*S,c.RR0*1.1,SW-c.RR0*1.1);
    c.hy=Math.max(c.RR0*.8+8*S,j.lid[1]*SY-210*SY);
    c.x=lerp(c.mx,c.hx,e)+Math.sin(c.t*.6)*7*S*e;
    c.y=lerp(c.my,c.hy,e)+Math.sin(c.t*.9)*5*S*e;
    c.RR=lerp(sR,c.RR0,e);
    c.glow=Math.max(0,c.glow-dt*3);

    if(c.state==='rising'&&c.k<.9&&Math.random()<dt*35)
      P.push({k:'smoke',x:c.x+rnd(-.3,.3)*c.RR,y:c.y+c.RR*.25,vx:rnd(-10,10)*S,vy:-rnd(5,25)*S,
        r:c.RR*rnd(.25,.45),gr:c.RR*.6,t:0,life:rnd(.6,1.1),a:.5,col:c.pal[0]});

    const em=c.state==='active'?1:(c.state==='rising'&&c.k>.7?(c.k-.7)/.3:0);
    c.acc+=cfg.rate*em*dt;
    while(c.acc>=1){c.acc-=1;cfg.spawn(c);}
    if(cfg.tick)cfg.tick(c,dt,em);

    if(cfg.dark)dark=Math.max(dark,e*cfg.dark);
    if(cfg.sun)sunV=Math.max(sunV,e*cfg.sun);
  }
  for(const c of clouds)if(c.cfg.bg)c.cfg.bg(c);
  for(let i=P.length-1;i>=0;i--){if(!stepParticle(P[i],dt)){P[i]=P[P.length-1];P.pop();}}
  drawBolts(dt);
  for(const c of clouds)drawCloud(c);

  if(flash>.01){ctx.fillStyle=`rgba(${flashCol},${flash})`;ctx.fillRect(0,0,SW,SH);flash-=dt*2.2;}else flash=0;
  if(shake>.001){const a=shake*30;stage.style.transform=`translate(${rnd(-a,a)}px,${rnd(-a,a)}px)`;shake=Math.max(0,shake-dt*1.2);}
  else if(stage.style.transform){stage.style.transform='';}
  dimEl.style.opacity=dark; sunEl.style.opacity=sunV;

  for(let i=clouds.length-1;i>=0;i--){
    const c=clouds[i];
    if(c.state==='returning'&&c.k<=0){c.alive=false;if(c.jar.cloud===c)c.jar.cloud=null;clouds.splice(i,1);}
  }
  requestAnimationFrame(frame);
}

/* ====== ЗАПУСК ====== */
(async function init(){
  const [a,b]=await Promise.all([loadImg(IMG_FULL),loadImg(IMG_EMPTY)]);
  if(!a){warn.hidden=false;warn.textContent='Не найден файл «'+IMG_FULL+'». Положи картинку рядом с этим html или поправь IMG_FULL в начале скрипта.';}
  imgA=a; imgB=b;
  if(a){natW=a.naturalWidth;natH=a.naturalHeight;resize();}
  if(!b&&a){console.warn('Нет '+IMG_EMPTY+': банки не будут «пустеть» при открытии');}
  buildHits();
  if(a)JARS.forEach(buildJarAssets);
  requestAnimationFrame(frame);
  setTimeout(()=>{hint.style.opacity=0;},9000);
})();
