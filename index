 {id:8, type:'wind', short:'высокие облака',
  name:'Перисто-кучевые облака – лёгкий бриз', badge:'верхний ярус облаков',
  altitude:'Высота: 6–8 км', temp:'+17 °C (ясно)', precip:'слабый высотный ветер',
