  body:[462,610,168,195], lid:[546,638,148], bLid:[546,638,148], region:[473,660,619,796], fronts:[],
  pal:[[236,245,253],[186,209,233],[138,165,200]], R:85},
 {id:11, type:'storm', short:'гроза и молния',
  name:'Кучево-дождевые облака – гроза и молния', badge:'грозовой разряд',
  altitude:'Высота: 1–12 км', temp:'+14 °C (грозовой фронт)', precip:'ливень, гром и молнии',
  desc:'Гигантская башня кучево-дождевого облака! При трении ледяных кристаллов и капель накапливается электрический заряд — возникает яркая молния, а нагретый воздух рождает раскат грома.',
  body:[742,562,168,210], lid:[826,588,148], bLid:[826,588,148], region:[753,610,899,763], fronts:[],
  pal:[[120,126,140],[66,70,84],[30,33,44]], R:100},
 {id:5, type:'sun', short:'кучевые облака',
  name:'Кучевые облака хорошей погоды – ясный день', badge:'любимое облако Луи',
  altitude:'Высота: 1–2 км', temp:'+22 °C (солнечно)', precip:'лёгкий ветерок',
  desc:'Пушистые белоснежные облака с плоским основанием и куполообразной вершиной. Появляются днём, когда тёплый воздух поднимается от нагретой солнцем земли.',
  body:[1068,203,160,182], lid:[1153,223,140], bLid:[1153,223,140], region:[1079,244,1217,376], fronts:[],
  pal:[[255,255,255],[240,244,250],[206,218,236]], R:80},
];
const byId=id=>JARS.find(j=>j.id===id);

/* ====== УТИЛИТЫ ====== */
const TAU=Math.PI*2;
const rnd=(a,b)=>a+Math.random()*(b-a);
const lerp=(a,b,t)=>a+(b-a)*t;
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const ease=t=>1-Math.pow(1-t,3);
const rgba=(c,a)=>`rgba(${c[0]},${c[1]},${c[2]},${a})`;
function rr(g,x,y,w,h,r){r=Math.min(r,w/2,h/2);g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}

const stage=document.getElementById('stage');
const scn=document.getElementById('scene'), sctx=scn.getContext('2d');
const cv=document.getElementById('fx'), ctx=cv.getContext('2d');
const dimEl=document.getElementById('dim'), sunEl=document.getElementById('sunglow');
const hint=document.getElementById('hint'), warn=document.getElementById('warn'), tip=document.getElementById('tip');
const DEBUG=location.search.includes('debug');
if(DEBUG)document.body.classList.add('debug');

let natW=W0, natH=H0, SW=W0, SH=H0, S=1, SY=1, DPR=1;
function resize(){
  const ratio=natW/natH;
  const w=Math.min(innerWidth,innerHeight*ratio);
  stage.style.width=w+'px'; stage.style.height=(w/ratio)+'px'; stage.style.setProperty('--u',w/W0);
  SW=w; SH=w/ratio; S=SW/W0; SY=SH/H0; DPR=Math.min(window.devicePixelRatio||1,2);
  for(const c of [cv,scn]){c.width=Math.round(SW*DPR);c.height=Math.round(SH*DPR);}
  ctx.setTransform(DPR,0,0,DPR,0,0); sctx.setTransform(DPR,0,0,DPR,0,0);
}
addEventListener('resize',resize); resize();

/* ====== ЗВУК ====== */
let AC=null, muted=false;
function ac(){ if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)();}catch(e){}} if(AC&&AC.state==='suspended')AC.resume(); return AC; }
function noiseBurst(dur,freq,vol){
  const a=ac(); if(!a||muted)return;
  const n=Math.floor(a.sampleRate*dur), buf=a.createBuffer(1,n,a.sampleRate), d=buf.getChannelData(0);
  for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/n,2);
  const s=a.createBufferSource(); s.buffer=buf;
  const f=a.createBiquadFilter(); f.type='lowpass'; f.frequency.value=freq;
  const g=a.createGain(); g.gain.value=vol; s.connect(f); f.connect(g); g.connect(a.destination); s.start();
}
function tone(f0,f1,dur,vol,type){
  const a=ac(); if(!a||muted)return;
  const o=a.createOscillator(), g=a.createGain(), t=a.currentTime;
  o.type=type||'sine'; o.frequency.setValueAtTime(f0,t); o.frequency.exponentialRampToValueAtTime(f1,t+dur*.8);
  g.gain.setValueAtTime(vol,t); g.gain.exponentialRampToValueAtTime(.001,t+dur);
  o.connect(g); g.connect(a.destination); o.start(); o.stop(t+dur+.01);
}
const popSnd=()=>tone(420,120,.15,.25), lidSnd=o=>tone(o?320:520,o?680:240,.18,.18,'triangle');
const thunder=()=>noiseBurst(1.8,320,.9), hailTick=()=>tone(1400+Math.random()*800,1200,.03,.02);
document.getElementById('snd').onclick=e=>{muted=!muted;e.target.textContent=muted?'🔇 Звук':'🔊 Звук'};

/* ====== СОСТОЯНИЕ ====== */
const P=[], B=[], clouds=[];
let flash=0, flashCol='255,255,255', shake=0, DT=.016;
const room=()=>P.length<2600;

/* ====== ПОГОДА: ЧАСТИЦЫ ====== */
function spawnRain(c,heavy,drizzle){
  if(!room())return;
  const x=c.x+rnd(-.85,.85)*c.RR, y=c.y+c.RR*.3;
  P.push({k:'rain',x,y,vx:-S*(heavy?130:drizzle?30:70),vy:S*rnd(drizzle?420:650,drizzle?600:1000)*(heavy?1.15:1),
    gy:SH*rnd(.82,.99),len:.03,col:heavy?'200,215,255':drizzle?'210,230,255':'185,210,240',w:heavy?1.8:drizzle?1.1:1.4});
}
function spawnHail(c){
  if(!room())return;
  P.push({k:'hail',x:c.x+rnd(-.85,.85)*c.RR,y:c.y+c.RR*.3,vx:rnd(-40,40)*S,vy:rnd(300,500)*S,
    r:rnd(3,5.5)*S,gy:SH*rnd(.84,.99),b:0,lie:0});
}
function spawnFog(c,col,A){
  if(!room())return;
  if(P.filter(p=>p.k==='fog').length>50)return;
  P.push({k:'fog',x:c.x+rnd(-.9,.9)*c.RR,y:c.y+c.RR*.4,vx:rnd(30,80)*S,vy:rnd(8,28)*S,
    r:rnd(70,150)*S,t:0,life:rnd(5,9),A:A||rnd(.10,.2),col:col||'225,236,245'});
}
const LEAF_COLS=['#e8a23a','#c8561f','#7bb34a','#d9c14a'];
function streak(c,col,w){
  P.push({k:'wind',x:c.x-c.RR*.5,y0:rnd(c.y,SH*.9),vx:rnd(500,900)*S,ph:rnd(0,TAU),amp:rnd(8,28)*S,fq:rnd(2,4),
    trail:[],len:(rnd(12,20))|0,col:col,w:w||2});
}
function dust(c,col){
  P.push({k:'dust',x:c.x-c.RR*.3,y0:rnd(c.y,SH*.9),vx:rnd(220,520)*S,ph:rnd(0,TAU),amp:rnd(6,22)*S,
    r:rnd(1,2.6)*S,col:col,t:0});
}
function spawnWind(c){
  if(!room())return;
  if(Math.random()<.65)streak(c,'255,255,255');
  else P.push({k:'leaf',x:c.x-c.RR*.4,y0:rnd(c.y,SH*.85),vx:rnd(300,620)*S,ph:rnd(0,TAU),amp:rnd(20,60)*S,
    rot:rnd(0,TAU),sp:rnd(-8,8),sz:rnd(5,9)*S,col:LEAF_COLS[(Math.random()*4)|0],t:0,sink:rnd(10,40)*S});
}
function spawnWarmWind(c){
  if(!room())return;
  if(Math.random()<.5)streak(c,'255,165,80'); else dust(c,'255,200,120');
  if(Math.random()<.2)P.push({k:'tw',x:clamp(c.x+rnd(-3,3)*c.RR,10,SW-10),y:rnd(c.y,SH*.9),t:0,life:rnd(1,2),s:rnd(3,6)*S});
}
function spawnDustWind(c){
  if(!room())return;
  const r=Math.random();
  if(r<.3)streak(c,'240,175,95',2.4); else if(r<.8)dust(c,'226,165,96'); else spawnFog(c,'235,185,110',rnd(.12,.22));
}
function spawnTwinkle(c){
  if(!room())return;
  P.push({k:'tw',x:clamp(c.x+rnd(-3,3)*c.RR,10,SW-10),y:rnd(c.y,SH*.95),t:0,life:rnd(1,2.2),s:rnd(3,7)*S});
}
/* плывущие по небу облака (для пасмурной/переменной/полуденной погоды) */
function pushDrift(c,x,y,R,vx,pal,a){ if(P.length<2600)P.push({k:'drift',x,y,R,vx,pal,a,t:rnd(0,9),age:0,owner:c}); }
const mkSheep=(c,i)=>pushDrift(c,i?rnd(0,SW):-80*S,SH*rnd(.05,.32),rnd(26,42)*S,rnd(14,26)*S,[[255,255,255],[236,242,250],[205,218,236]],.85);
const mkNoon =(c,i)=>pushDrift(c,i?rnd(0,SW):-140*S,SH*rnd(.06,.3),rnd(55,85)*S,rnd(8,16)*S,[[255,255,255],[248,250,253],[220,230,242]],.95);
const mkGray =(c,i)=>pushDrift(c,i?rnd(0,SW):-200*S,SH*rnd(.03,.22),rnd(70,110)*S,rnd(14,28)*S,[[150,154,162],[104,108,116],[66,70,80]],.82);
function driftTick(c,dt,em,o){
  if(em<=0)return;
  if(!c.inited){c.inited=true;for(let i=0;i<o.n;i++)o.mk(c,true);}
  c.da=(c.da||0)+dt*o.rate*em;
  while(c.da>=1){c.da-=1;o.mk(c,false);}
}

/* молния */
function makeBolt(c){
  const x0=c.x+rnd(-.5,.5)*c.RR, y0=c.y+c.RR*.3;
  const x1=clamp(x0+rnd(-.25,.25)*SW,20,SW-20), y1=SH*rnd(.78,.98);
  const pts=[[x0,y0]], branches=[], n=14;
  for(let i=1;i<=n;i++){
    const f=i/n, x=lerp(x0,x1,f)+(i<n?rnd(-1,1)*38*S:0), y=lerp(y0,y1,f)+rnd(-.5,.5)*14*S;
    pts.push([x,y]);
    if(i>2&&i<n-1&&Math.random()<.22){
      const b=[[x,y]]; let bx=x,by=y; const dir=Math.random()<.5?-1:1;
      for(let k=0;k<5;k++){bx+=dir*rnd(10,34)*S;by+=rnd(14,40)*S;b.push([bx,by]);}
      branches.push(b);
    }
  }
  B.push({pts,branches,t:0,life:.45});
  for(let i=0;i<14;i++){const a=rnd(Math.PI,TAU),sp=rnd(80,320)*S;
    P.push({k:'spark',x:x1,y:y1,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,t:0,life:rnd(.3,.7),r:rnd(1.2,2.4)*S});}
  flash=Math.max(flash,.55); flashCol='235,240,255'; c.glow=1; shake=Math.max(shake,.12); thunder();
}
function stormTick(c,dt,em){
  if(em<1)return;
  c.nb=(c.nb===undefined?.8:c.nb)-dt;
  if(c.nb<=0){makeBolt(c);c.nb=Math.random()<.3?rnd(.1,.25):rnd(.9,2.6);}
}

/* ====== ФОНОВЫЕ ЭФФЕКТЫ (солнце, радуга) ====== */
function sunBg(c){
  const e=c.e; if(e<=.01)return;
  const sx=c.x+c.RR*.55, sy=c.y-c.RR*.35, sr=c.RR*.62*e;
  ctx.save(); ctx.globalCompositeOperation='lighter';
  let g=ctx.createLinearGradient(0,sy,0,SH);
  g.addColorStop(0,`rgba(255,225,140,${.28*e})`); g.addColorStop(1,'rgba(255,225,140,0)');
  ctx.fillStyle=g; ctx.beginPath();
  ctx.moveTo(sx-sr*.5,sy); ctx.lineTo(sx+sr*.5,sy); ctx.lineTo(sx+SW*.28,SH); ctx.lineTo(sx-SW*.38,SH); ctx.closePath(); ctx.fill();
  g=ctx.createRadialGradient(sx,sy,sr*.3,sx,sy,sr*3);
  g.addColorStop(0,`rgba(255,235,150,${.7*e})`); g.addColorStop(1,'rgba(255,200,80,0)');
  ctx.fillStyle=g; ctx.beginPath(); ctx.arc(sx,sy,sr*3,0,TAU); ctx.fill();
  ctx.restore();
  ctx.save(); ctx.translate(sx,sy); ctx.rotate(c.t*.25);
  ctx.strokeStyle=`rgba(255,220,100,${.8*e})`; ctx.lineCap='round'; ctx.lineWidth=5*S;
  for(let i=0;i<14;i++){ctx.rotate(TAU/14);ctx.beginPath();ctx.moveTo(sr*1.25,0);ctx.lineTo(sr*(1.55+.15*Math.sin(c.t*3+i)),0);ctx.stroke();}
  ctx.restore();
  const dg=ctx.createRadialGradient(sx-sr*.3,sy-sr*.3,sr*.1,sx,sy,sr);
  dg.addColorStop(0,'#fff6b0'); dg.addColorStop(1,'#ffb92e');
  ctx.save(); ctx.globalAlpha=Math.min(1,e*1.5); ctx.fillStyle=dg;
  ctx.beginPath(); ctx.arc(sx,sy,sr,0,TAU); ctx.fill(); ctx.restore();
}
const RB_COLS=['#ff4d4d','#ff944d','#ffe14d','#6bdc5a','#4db8ff','#5a63ff','#a24dff'];
function rainbowBg(c){
  c.rb=clamp((c.rb||0)+(c.state==='active'?DT/2.5:-DT/1.2),0,1);
  if(c.rb<=0)return;
  const r0=Math.min(SW*.42,SH*.85), cx=c.x*.4+SW*.5*.6, cy=SH, bw=r0*.045;
  ctx.save(); ctx.lineWidth=bw+1; ctx.lineCap='butt'; ctx.globalAlpha=.38;
  RB_COLS.forEach((col,i)=>{ctx.strokeStyle=col;ctx.beginPath();ctx.arc(cx,cy,r0-i*bw,Math.PI,Math.PI+Math.PI*ease(c.rb));ctx.stroke();});
  ctx.restore();
}

